# Postgres Configuration (Template)
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_db_name_here
DB_PORT=5432

# Server
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_TTL=24h

# Documents
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
INGEST_WORKERS=2
INGEST_QUEUE_SIZE=100

# --- AI features (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SUMMARY_MODEL=
GROQ_TPM_BUDGET=6000
ASK_TOP_K=4
ASK_CONTEXT_TOKENS=3000
ASK_MAX_OUTPUT_TOKENS=1500
ASK_MAX_QUESTION_CHARS=1000
LLM_RATE_PER_MINUTE=6
LLM_MAX_CONCURRENT_PER_USER=2

# Summary
SUMMARY_GROUP_TOKENS=2500
SUMMARY_MAX_OUTPUT_TOKENS=800
SUMMARY_MAX_CHUNKS=120
SUMMARY_WORKERS=1